---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  readTime?: string;
}

const { title, description, pubDate, tags, readTime } = Astro.props;

// Function to generate slug from heading text
function generateSlug(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '') // Remove special characters
    .replace(/\s+/g, '-') // Replace spaces with hyphens
    .replace(/-+/g, '-') // Replace multiple hyphens with single
    .trim();
}

// Function to extract headings from rendered content (only H2 and H3)
function extractHeadings(content: string) {
  const headingRegex = /<h([2-3])[^>]*>(.*?)<\/h[2-3]>/gi;
  const headings: Array<{level: number, text: string, slug: string}> = [];
  let match;
  
  while ((match = headingRegex.exec(content)) !== null) {
    const level = parseInt(match[1]);
    const text = match[2].replace(/<[^>]*>/g, '').trim(); // Remove HTML tags
    const slug = generateSlug(text);
    headings.push({ level, text, slug });
  }
  
  return headings;
}

// Get the rendered content to extract headings
const renderedContent = await Astro.slots.render('default');
const headings = extractHeadings(renderedContent);
---

<Layout title={title} description={description}>
  <Header />
  
  <main class="blog-content">
    <div class="blog-container">
      <!-- Table of Contents Sidebar -->
      <aside class="toc-sidebar">
        <div class="toc-content">
          <h3>Topics</h3>
          <nav class="toc-nav">
            {headings.length > 0 ? (
              <ul>
                {headings.map((heading, index) => {
                  const nextHeading = headings[index + 1];
                  const hasChildren = nextHeading && nextHeading.level > heading.level;
                  
                  if (heading.level === 2) {
                    // Find all h3 children for this h2
                    const children = [];
                    for (let i = index + 1; i < headings.length; i++) {
                      const child = headings[i];
                      if (child.level === 2) break; // Stop at next h2
                      if (child.level === 3) {
                        children.push(child);
                      }
                    }
                    
                    return (
                      <li>
                        <a href={`#${heading.slug}`}>{heading.text}</a>
                        {children.length > 0 && (
                          <ul>
                            {children.map((child) => (
                              <li>
                                <a href={`#${child.slug}`}>{child.text}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    );
                  }
                  
                  // Skip h3 as they're handled as children of h2
                  return null;
                })}
              </ul>
            ) : (
              <p>No headings found</p>
            )}
          </nav>
        </div>
      </aside>

      <!-- Main Article Content -->
      <article class="main-article">
        <header class="blog-header">
          <h1>{title}</h1>
          <div class="blog-meta">
            {pubDate}
            </time>
            <div class="blog-tags">
              {tags.map(tag => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
            {readTime && (
              <div class="read-time">
                <span class="read-time-badge">⏱️ Read Time: {readTime}</span>
              </div>
            )}
          </div>
        </header>
        
        <div class="blog-body">
          <Fragment set:html={renderedContent.replace(/<h([2-3])([^>]*)>(.*?)<\/h[2-3]>/gi, (match, level, attrs, text) => {
            const cleanText = text.replace(/<[^>]*>/g, '').trim();
            const slug = generateSlug(cleanText);
            return `<h${level}${attrs} id="${slug}">${text}</h${level}>`;
          })} />
        </div>
      </article>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  .blog-content {
    max-width: 1300px;
    margin: 0 auto 4rem;
    padding: 120px 2rem 0;
    background: linear-gradient(135deg, var(--background-color) 0%, #f8f9fa 100%);
    min-height: calc(100vh - 200px);
  }

  .blog-container {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Table of Contents Sidebar */
  .toc-sidebar {
    position: sticky;
    top: 140px;
    height: fit-content;
    max-height: calc(100vh - 160px);
    overflow-y: auto;
  }

  .toc-content {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
  }

  .toc-content h3 {
    margin: 0 0 1rem 0;
    font-size: 1.1rem;
    color: var(--text-color);
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 0.5rem;
  }

  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-nav > ul > li {
    margin-bottom: 0.2rem;
  }

  .toc-nav ul ul {
    margin-left: 1rem;
    margin-top: 0.1rem;
  }

  .toc-nav ul ul li {
    margin-bottom: 0.1rem;
  }

  .toc-nav a {
    display: block;
    padding: 0.25rem 0.8rem;
    color: var(--text-color);
    text-decoration: none;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.3;
    transition: all 0.2s ease;
  }

  .toc-nav a:hover {
    background: #f1f5f9;
    color: #4f46e5;
    transform: translateX(4px);
  }

  .toc-nav ul ul a {
    font-size: 0.85rem;
    color: #64748b;
    padding: 0.2rem 0.8rem;
  }

  .toc-nav ul ul a:hover {
    color: #4f46e5;
    background: #f8fafc;
  }

  /* Main Article */
  .main-article {
    min-width: 0; /* Prevents grid overflow */
  }

  .blog-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .blog-header h1 {
    font-size: 2rem;
    color: var(--text-color);
    margin-bottom: 1rem;
  }

  .blog-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    color: var(--text-color);
    opacity: 0.8;
  }

  .blog-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    color: var(--primary-color);
    font-size: 0.9rem;
    padding: 0.25rem 0.5rem;
    background: rgba(var(--primary-color-rgb, 75, 85, 99), 0.1);
    border-radius: 12px;
    font-weight: 500;
  }

  .read-time {
    margin-top: 0.01rem;
  }

  .read-time-badge {
    display: inline-block;
    background: linear-gradient(135deg, #f3e5f5 0%, #fce4ec 100%);
    color: #7b1fa2;
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    font-weight: 500;
    border: 1px solid #e1bee7;
    box-shadow: 0 2px 4px rgba(123, 31, 162, 0.1);
  }

  .blog-body {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-color);
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  /* Markdown styles */
  .blog-body :global(h2) {
    font-size: 1.4rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--text-color);
    font-weight: 600;
  }

  .blog-body :global(h3) {
    font-size: 1.2rem;
    margin: 1.25rem 0 0.75rem;
    color: var(--text-color);
    font-weight: 600;
  }

  .blog-body :global(h4) {
    font-size: 1.1rem;
    margin: 1rem 0 0.5rem;
    color: var(--text-color);
    font-weight: 600;
  }

  .blog-body :global(h5) {
    font-size: 1rem;
    margin: 0.75rem 0 0.5rem;
    color: var(--text-color);
    font-weight: 600;
  }

  .blog-body :global(h6) {
    font-size: 0.95rem;
    margin: 0.75rem 0 0.5rem;
    color: var(--text-color);
    font-weight: 600;
  }

  .blog-body :global(p) {
    margin-bottom: 1.2rem;
    color: var(--text-color);
  }

  .blog-body :global(ul), 
  .blog-body :global(ol) {
    margin: 0.8rem 0;
    padding-left: 2rem;
    color: var(--text-color);
  }

  .blog-body :global(li) {
    margin-bottom: 0.3rem;
  }

  .blog-body :global(blockquote) {
    border-left: 4px solid var(--primary-color);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--text-color);
    opacity: 0.8;
  }

  .blog-body :global(code) {
    background: #f8f9fa;
    padding: 0.2rem 0.4rem;
    border-radius: 4px;
    font-family: monospace;
  }

  .blog-body :global(pre) {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  /* Pastel Callout Boxes */
  .blog-body :global(.callout) {
    padding: 1.5rem;
    border-radius: 12px;
    margin: 2rem 0;
    border-left: 4px solid;
    position: relative;
    font-size: 1rem;
  }

  .blog-body :global(.callout-info) {
    background: linear-gradient(135deg, #e3f2fd 0%, #f0f8ff 100%);
    border-left-color: #2196f3;
    color: #1565c0;
  }

  .blog-body :global(.callout-tip) {
    background: linear-gradient(135deg, #f3e5f5 0%, #fce4ec 100%);
    border-left-color: #9c27b0;
    color: #7b1fa2;
  }

  .blog-body :global(.callout-warning) {
    background: linear-gradient(135deg, #fff3e0 0%, #fef7e0 100%);
    border-left-color: #ff9800;
    color: #e65100;
  }

  .blog-body :global(.callout-success) {
    background: linear-gradient(135deg, #e8f5e8 0%, #f1f8e9 100%);
    border-left-color: #4caf50;
    color: #2e7d32;
  }

  .blog-body :global(.callout-note) {
    background: linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%);
    border-left-color: #e91e63;
    color: #ad1457;
  }

  .blog-body :global(.callout-code) {
    background: linear-gradient(135deg, #f5f5f5 0%, #eeeeee 100%);
    border-left-color: #607d8b;
    color: #37474f;
    font-family: monospace;
  }

  .blog-body :global(.callout-prompt) {
    background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
    border-left-color: #4f46e5;
    color: #1e293b;
    position: relative;
  }

  .blog-body :global(.callout-prompt::before) {
    content: "";
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-size: 1.2rem;
  }

  .blog-body :global(.callout h4) {
    margin: 0 0 0.5rem 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .blog-body :global(.callout p:last-child) {
    margin-bottom: 0;
  }

  /* Side-by-side callouts */
  .blog-body :global(.callout-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1rem 0;
  }

  @media (max-width: 768px) {
    .blog-body :global(.callout-grid) {
      grid-template-columns: 1fr;
    }
  }

  /* Custom numbered lists */
  .blog-body :global(.numbered-list) {
    counter-reset: item;
    padding-left: 0;
    list-style: none;
  }

  .blog-body :global(.numbered-list > li) {
    counter-increment: item;
    margin-bottom: 0.8rem;
    position: relative;
    padding-left: 2rem;
  }

  .blog-body :global(.numbered-list > li::before) {
    content: counter(item) ".";
    position: absolute;
    left: 0;
    top: 0;
    color: #4f46e5;
    font-weight: 600;
    font-size: 1rem;
    min-width: 1.5rem;
  }

  /* Checklist style */
  .blog-body :global(.checklist) {
    list-style: none;
    padding-left: 0;
  }

  .blog-body :global(.checklist > li) {
    position: relative;
    padding-left: 1.8rem;
    margin-bottom: 0.5rem;
  }

  .blog-body :global(.checklist > li::before) {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0.1rem;
    color: #10b981;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .blog-body :global(pre) {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .blog-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  /* Elegant horizontal dividers */
  .blog-body :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, #e2e8f0 20%, #cbd5e1 50%, #e2e8f0 80%, transparent 100%);
    margin: 3rem 0;
    position: relative;
  }

  .blog-body :global(hr::before) {
    content: "✦";
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    background: white;
    color: #94a3b8;
    padding: 0 1rem;
    font-size: 1rem;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  @media (max-width: 1024px) {
    .blog-container {
      grid-template-columns: 240px 1fr;
      gap: 2rem;
    }
    
    .toc-sidebar {
      top: 120px;
    }
  }

  @media (max-width: 768px) {
    .blog-content {
      padding: 100px 1rem 0;
    }

    .blog-container {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .toc-sidebar {
      position: relative;
      top: auto;
      order: -1;
      max-height: none;
    }

    .toc-content {
      padding: 1rem;
    }

    .toc-content h3 {
      font-size: 1rem;
    }

    .blog-header h1 {
      font-size: 2rem;
    }

    .blog-meta {
      flex-direction: column;
      gap: 0.5rem;
    }

    .blog-body {
      padding: 1.5rem;
    }
  }
</style> 